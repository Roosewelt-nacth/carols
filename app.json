{
  "expo": {
    "name": "Carols",
    "slug": "carols",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.victoriansyouth.carols"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#8E1E30",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "org.victoriansyouth.carols"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Carols by Victorians Youth"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store"
    ],
    "scheme": "carols"
  }
}